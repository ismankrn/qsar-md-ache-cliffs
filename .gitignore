# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Scratch renders kept out of version control
figures/_*.png

# Docking poses are now tracked, both sets. They are the expensive artefacts: stage 07
# took hours and stage 11's ensemble poses took 48 h, and neither can be downloaded from
# anywhere. 16 MB + 37 MB is worth carrying so the repository is a real second copy.

# Crystal structures are NOT tracked: 50 MB of public data, re-downloadable from RCSB by
# scripts/select_ensemble.py. Keeping them out is what pays for carrying the poses.
structures/*.pdb

# Credentials and access notes — never commit
references/
*.pem
*_credentials*

# Export-validation intermediates: ~15 MB of .top/.gro/.npy regenerable by
# scripts/validate_gmx_export.py. The findings live in
# results/12_gmx_export_validation.md; the reference energies and the .mdp are kept.
md/export_check/*.top
md/export_check/*.gro
md/export_check/*.trr
md/export_check/*.npy

# MDAnalysis offset caches
.*_offsets.npz
.*_offsets.lock

# Reduced MD trajectories: ~16 MB per run, ~3.5 GB at 217 runs. They exist so a trajectory
# can be revisited after the 2 GB original is deleted, and they are backed by the rented
# instances until those are released -- but they are regenerable output, not findings.
# The descriptors extracted from them (results/16_rung4_per_run/) ARE tracked.
md/reduced/

# Per-run QC panels: one ~200 KB page per run, 217 of them, regenerable in seconds by
# scripts/rung4_qc_plots.py from the reduced archives. The fleet summary and the flag
# table are small and are tracked.
results/16c_qc/
