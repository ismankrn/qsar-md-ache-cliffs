  journal = {Journal of Chemical Information and Modeling},
  volume  = {55}, number = {5}, pages = {1062--1076}, year = {2015},
  doi     = {10.1021/ci500742b},
  note    = {VERIFIED via Crossref 2026-10-20, author list included. Engage with
             this paper rather than citing
             its abstract: template docking reaches a median 90\% but uses the
